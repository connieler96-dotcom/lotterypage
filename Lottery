<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>线上活动 - 幸运大抽奖总结版</title>
    <style>
        /* 黑色背景 000000 */
        body { 
            font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif; 
            background-color: #000000; 
            color: rgba(255, 255, 255, 0.85); 
            display: flex; 
            justify-content: center; 
            align-items: center; 
            min-height: 100vh; 
            margin: 0;
            padding: 20px;
            box-sizing: border-box;
        }

        /* 蓝色霓虹渐变边框 #3403b4 */
        .container { 
            width: 800px; 
            background: linear-gradient(135deg, #11013b 0%, #000000 100%);
            padding: 40px; 
            border-radius: 24px; 
            border: 2px solid #3403b4;
            box-shadow: 0 0 30px rgba(52, 3, 180, 0.4);
            text-align: center; 
            transition: all 0.5s ease;
        }

        h1 { 
            font-size: 32px; 
            color: #ffffff; 
            margin-top: 0;
            letter-spacing: 2px;
            text-shadow: 0 0 10px rgba(255, 255, 255, 0.5);
        }

        .select-group {
            margin-bottom: 25px;
        }
        select { 
            font-size: 16px; 
            padding: 10px 20px; 
            background: #111; 
            color: #fff; 
            border: 1px solid #3403b4; 
            border-radius: 8px;
            cursor: pointer;
            outline: none;
        }

        /* 滚动大屏 */
        .display-box { 
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 16px;
            padding: 20px;
            margin: 25px 0;
            min-height: 100px;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 40px; 
            color: #ffffff; 
            font-weight: bold;
            letter-spacing: 2px;
        }

        /* 粉色按钮 #fc0c97 */
        .btn-draw { 
            font-size: 22px; 
            font-weight: bold;
            padding: 14px 60px; 
            cursor: pointer; 
            background: #fc0c97; 
            color: white; 
            border: none; 
            border-radius: 50px; 
            box-shadow: 0 0 20px rgba(252, 12, 151, 0.5);
            transition: all 0.3s ease;
            letter-spacing: 4px;
            margin-bottom: 20px;
        }
        .btn-draw:hover { 
            background: #d0077b; 
            box-shadow: 0 0 25px rgba(252, 12, 151, 0.8);
            transform: scale(1.03);
        }
        .btn-draw.active {
            background: #3403b4;
            box-shadow: 0 0 20px rgba(52, 3, 180, 0.6);
        }

        /* 组合总结网格布局 */
        .summary-title {
            display: none;
            color: #fff600; /* 黄色高亮 */
            font-size: 22px;
            margin: 25px 0 15px 0;
            font-weight: bold;
            letter-spacing: 1px;
        }
        .result-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
            margin-top: 10px;
            max-height: 400px;
            overflow-y: auto;
            padding-right: 5px;
        }
        /* 美化滚动条 */
        .result-grid::-webkit-scrollbar { width: 6px; }
        .result-grid::-webkit-scrollbar-thumb { background: #3403b4; border-radius: 3px; }

        /* 卡片设计 */
        .result-card {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(52, 3, 180, 0.3);
            padding: 15px;
            border-radius: 12px;
            text-align: left;
            display: flex;
            flex-direction: column;
            justify-content: center;
            animation: fadeInUp 0.4s ease forwards;
            opacity: 0;
        }
        .card-teacher {
            font-size: 20px;
            color: #ffffff; /* 白色 50% 以上视觉权重 */
            font-weight: bold;
            margin-bottom: 5px;
        }
        .card-staff {
            font-size: 14px;
            color: rgba(255, 255, 255, 0.6);
        }
        .highlight-staff {
            color: #fff600; /* 强力组合用黄色点缀 */
        }

        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(15px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body>

<div class="container">
    <h1>🎉 线上大抽奖系统 🎉</h1>
    
    <div class="select-group">
        <select id="prize-select" onchange="resetDisplay()">
            <option value="A">🎁 幸运抽奖：A组轮次</option>
            <option value="B">🎁 幸运抽奖：B组轮次</option>
        </select>
    </div>

    <div class="display-box" id="main-screen">
        等待开奖
    </div>

    <button id="action-btn" class="btn-draw" onclick="toggleDraw()">开始抽奖</button>

    <!-- 结果总结面板 -->
    <div class="summary-title" id="summary-hd">✨ 本轮中奖组合最终总结 ✨</div>
    <div class="result-grid" id="result-container"></div>
</div>

<script>
    // 完整的名单数据
    const groupA = [
        { teacher: "Kiwi", lc: "", ec: "Marcus" },
        { teacher: "Angie", lc: "", ec: "Celeste" },
        { teacher: "Hanson", lc: "", ec: "Elva" },
        { teacher: "Rachel", lc: "", ec: "Nicole" },
        { teacher: "Abby", lc: "", ec: "Xueling" },
        { teacher: "Melissa", lc: "", ec: "Derrick" },
        { teacher: "Sophia", lc: "", ec: "Felicia" },
        { teacher: "Happy", lc: "ZhiQing", ec: "" },
        { teacher: "Jessie", lc: "Voilet", ec: "" },
        { teacher: "Regina", lc: "Crystal", ec: "" },
        { teacher: "Jenny", lc: "Chinfui", ec: "" }
    ];

    const groupB = [
        { teacher: "Kelly", lc: "Qijing", ec: "" },
        { teacher: "Madeline", lc: "Rocket", ec: "" },
        { teacher: "Master Tan", lc: "Abbey", ec: "" },
        { teacher: "Henry", lc: "Yiman", ec: "" },
        { teacher: "Audrey", lc: "Chinfui", ec: "Marcus" },
        { teacher: "Angeline", lc: "Qijing", ec: "Celeste" },
        { teacher: "Joey", lc: "", ec: "Elva" },
        { teacher: "KC", lc: "Abbey", ec: "Nicole" },
        { teacher: "Kee", lc: "Rocket", ec: "Xueling" },
        { teacher: "Tina", lc: "Yiman", ec: "Derrick" },
        { teacher: "Eunice", lc: "", ec: "Felicia" },
        { teacher: "Li Jia (Part Time)", lc: "ZhiQing", ec: "" },
        { teacher: "Danny (Part Time)", lc: "Voilet", ec: "" },
        { teacher: "Qing (Part Time)", lc: "Crystal", ec: "" }
    ];

    let timer = null;
    let isRolling = false;

    function resetDisplay() {
        if (!isRolling) {
            document.getElementById('main-screen').innerText = "等待开奖";
            document.getElementById('result-container').innerHTML = "";
            document.getElementById('summary-hd').style.display = "none";
        }
    }

    function toggleDraw() {
        const btn = document.getElementById('action-btn');
        const mainScreen = document.getElementById('main-screen');
        const container = document.getElementById('result-container');
        const summaryHd = document.getElementById('summary-hd');
        const selectedGroup = document.getElementById('prize-select').value;
        
        const currentPool = (selectedGroup === 'A') ? groupA : groupB;

        if (!isRolling) {
            // === 开始滚动 ===
            isRolling = true;
            btn.innerText = "停止";
            btn.classList.add('active');
            summaryHd.style.display = "none";
            container.innerHTML = "";
            
            timer = setInterval(() => {
                // 屏幕大字疯狂闪烁任意组合，保持抽奖的动态感
                let randIdx = Math.floor(Math.random() * currentPool.length);
                mainScreen.innerText = `正在计算：${currentPool[randIdx].teacher}`;
            }, 50);
            
        } else {
            // === 点击停止（一键出全组结果） ===
            isRolling = false;
            clearInterval(timer);
            btn.innerText = "开始抽奖";
            btn.classList.remove('active');

            mainScreen.innerText = "🎉 抽取完成！";
            summaryHd.style.display = "block";

            // 洗牌算法（Shuffle），让每次出来的卡片顺序打乱，显得是现场随机抽出来的
            let shuffledPool = [...currentPool].sort(() => Math.random() - 0.5);

            // 渲染出所有组合的卡片总结
            shuffledPool.forEach((item, index) => {
                let card = document.createElement('div');
                card.className = 'result-card';
                // 让卡片有一个帅气的逐个淡入流光效果
                card.style.animationDelay = `${index * 0.05}s`;

                let staffText = [];
                if(item.lc) staffText.push(`<span class="highlight-staff">LC:</span> ${item.lc}`);
                if(item.ec) staffText.push(`<span class="highlight-staff">EC:</span> ${item.ec}`);
                
                card.innerHTML = `
                    <div class="card-teacher">👤 教师: ${item.teacher}</div>
                    <div class="card-staff">${staffText.join(' &nbsp;&nbsp; ') || '✨ 独立单元'}</div>
                `;
                container.appendChild(card);
            });
        }
    }
</script>
</body>
</html>
