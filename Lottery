<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <title>线上活动 - 幸运大抽奖大总榜版</title>
    <style>
        body { font-family: sans-serif; background: #000; color: rgba(255,255,255,.85); display: flex; justify-content: center; align-items: center; min-height: 100vh; margin: 0; padding: 20px; box-sizing: border-box; }
        .box { width: 820px; background: linear-gradient(135deg, #11013b 0%, #000 100%); padding: 40px; border-radius: 24px; border: 2px solid #3403b4; box-shadow: 0 0 30px rgba(52,3,180,.4); text-align: center; }
        h1 { font-size: 32px; color: #fff; margin: 0 0 10px 0; text-shadow: 0 0 10px rgba(255,255,255,.5); }
        .badge { display: inline-block; background: rgba(52,3,180,.6); border: 1px solid #3403b4; padding: 6px 20px; border-radius: 20px; font-size: 16px; margin-bottom: 20px; transition: all .3s; }
        .screen { background: rgba(255,255,255,.03); border: 1px solid rgba(255,255,255,.1); border-radius: 16px; padding: 25px; margin: 15px 0 25px 0; min-height: 80px; display: flex; justify-content: center; align-items: center; font-size: 38px; color: #fff; font-weight: bold; }
        .btn { font-size: 22px; font-weight: bold; padding: 14px 60px; cursor: pointer; background: #fc0c97; color: #fff; border: none; border-radius: 50px; box-shadow: 0 0 20px rgba(252,12,151,.5); transition: all .3s ease; outline: none; }
        .btn:hover { background: #d0077b; transform: scale(1.02); }
        .btn:disabled { background: #444 !important; box-shadow: none !important; cursor: not-allowed; color: #aaa; }
        .btn.next { background: #fff600; color: #000; box-shadow: 0 0 20px rgba(255,246,0,.4); }
        .btn.next:hover { background: #d4cc00; }
        .title { display: none; color: #fff600; font-size: 24px; margin: 30px 0 15px 0; font-weight: bold; }
        .list-wrap { display: none; background: rgba(255,255,255,.02); border: 1px solid rgba(255,255,255,.08); border-radius: 12px; max-height: 400px; overflow-y: auto; margin-top: 15px; }
        .list-wrap::-webkit-scrollbar { width: 6px; }
        .list-wrap::-webkit-scrollbar-thumb { background: #3403b4; border-radius: 3px; }
        .tbl { width: 100%; border-collapse: collapse; text-align: left; font-size: 18px; }
        .tbl th { background: #1a0259; color: #fff600; padding: 14px 20px; border-bottom: 1px solid #3403b4; position: sticky; top: 0; z-index: 10; }
        .tbl td { padding: 14px 20px; border-bottom: 1px solid rgba(255,255,255,.05); color: #fff; }
        .tbl tr:nth-child(even) { background: rgba(255,255,255,.02); }
        .row-in { opacity: 0; animation: rIn 0.15s ease forwards; }
        .lbl { color: rgba(255,255,255,.5); font-size: 14px; margin-right: 5px; }
        .tag { font-size: 12px; padding: 3px 8px; border-radius: 4px; font-weight: bold; margin-left: 10px; }
        .t-a { background: rgba(52,3,180,.4); color: #fff; border: 1px solid #3403b4; }
        .t-b { background: rgba(252,12,151,.2); color: #fc0c97; border: 1px solid #fc0c97; }
        @keyframes rIn { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: translateY(0); } }
    </style>
</head>
<body>

<div class="box">
    <h1>🎉 你真的懂咩？ 🎉</h1>
    <div class="badge" id="s-badge">当前环节：🎁 A 组幸运抽取</div>
    <div class="screen" id="m-screen">等待开启</div>
    <button id="act-btn" class="btn" onclick="handleDrawFlow()">开始抽奖</button>

    <div class="title" id="sm-hd">✨ 本轮中奖组合最终结果 ✨</div>
    <div class="list-wrap" id="l-wrap">
        <table class="tbl">
            <thead>
                <tr>
                    <th style="width: 10%;">序号</th>
                    <th style="width: 45%;">👤 获得者 (Teacher)</th>
                    <th style="width: 45%;">🏆 关联组合 (LC / EC)</th>
                </tr>
            </thead>
            <tbody id="l-body"></tbody>
        </table>
    </div>
</div>

<script>
    const groupA = [
        { teacher: "Kiwi", lc: "", ec: "Marcus" },
        { teacher: "Angie", lc: "", ec: "Celeste" },
        { teacher: "Hanson", lc: "", ec: "Elva" },
        { teacher: "Rachel", lc: "", ec: "Nicole" },
        { teacher: "Abby", lc: "", ec: "Xueling" },
        { teacher: "Melissa", lc: "", ec: "Derrick" },
        { teacher: "Sophia", lc: "", ec: "Felicia" },
        { teacher: "Happy", lc: "ZhiQing", ec: "" },
        { teacher: "Jessie", lc: "Voilet", ec: "" },
        { teacher: "Regina", lc: "Crystal", ec: "" },
        { teacher: "Jenny", lc: "Chinfui", ec: "" }
    ];

    const groupB = [
        { teacher: "Kelly", lc: "Qijing", ec: "" },
        { teacher: "Madeline", lc: "Rocket", ec: "" },
        { teacher: "Master Tan", lc: "Abbey", ec: "" },
        { teacher: "Henry", lc: "Yiman", ec: "" },
        { teacher: "Audrey", lc: "Chinfui", ec: "Marcus" },
        { teacher: "Angeline", lc: "Qijing", ec: "Celeste" },
        { teacher: "Joey", lc: "", ec: "Elva" },
        { teacher: "KC", lc: "Abbey", ec: "Nicole" },
        { teacher: "Kee", lc: "Rocket", ec: "Xueling" },
        { teacher: "Tina", lc: "Yiman", ec: "Derrick" },
        { teacher: "Eunice", lc: "", ec: "Felicia" },
        { teacher: "Li Jia (Part Time)", lc: "ZhiQing", ec: "" },
        { teacher: "Danny (Part Time)", lc: "Voilet", ec: "" },
        { teacher: "Qing (Part Time)", lc: "Crystal", ec: "" }
    ];

    let step = 1; 
    let timer = null;

    function handleDrawFlow() {
        const btn = document.getElementById('act-btn');
        const mScreen = document.getElementById('m-screen');
        const lWrap = document.getElementById('l-wrap');
        const lBody = document.getElementById('l-body');
        const smHd = document.getElementById('sm-hd');
        const sBadge = document.getElementById('s-badge');

        if (step === 1) {
            btn.disabled = true;
            lWrap.style.display = "none";
            smHd.style.display = "none";
            lBody.innerHTML = "";

            timer = setInterval(() => {
                let idx = Math.floor(Math.random() * groupA.length);
                mScreen.innerText = `🎲 正在计算中：${groupA[idx].teacher}`;
            }, 50);

            setTimeout(() => {
                clearInterval(timer);
                mScreen.innerText = "🎉 A组抽取成功！";
                smHd.innerText = "✨ A组中奖组合最终结果 ✨";
                smHd.style.display = "block";
                lWrap.style.display = "block";
                renderRows(groupA);
                step = 2;
                btn.innerText = "➡️ 切换至 B 组抽奖";
                btn.className = "btn next";
                btn.disabled = false;
            }, 3000);
        } 
        else if (step === 2) {
            step = 3;
            sBadge.innerText = "当前环节：🎁 B 组幸运抽取";
            sBadge.style.background = "rgba(252, 12, 151, .3)";
            sBadge.style.borderColor = "#fc0c97";
            mScreen.innerText = "等待开启";
            lWrap.style.display = "none";
            smHd.style.display = "none";
            lBody.innerHTML = "";
            btn.innerText = "开始抽奖";
            btn.className = "btn";
        } 
        else if (step === 3) {
            btn.disabled = true;
            lWrap.style.display = "none";
            smHd.style.display = "none";
            lBody.innerHTML = "";

            timer = setInterval(() => {
                let idx = Math.floor(Math.random() * groupB.length);
                mScreen.innerText = `🎲 正在计算中：${groupB[idx].teacher}`;
            }, 50);

            setTimeout(() => {
                clearInterval(timer);
                mScreen.innerText = "🎉 B组抽取成功！";
                smHd.innerText = "✨ B组中奖组合最终结果 ✨";
                smHd.style.display = "block";
                lWrap.style.display = "block";
                renderRows(groupB);
                step = 4;
                btn.innerText = "📊 生成 A + B 完整大总榜";
                btn.className = "btn next";
                btn.disabled = false;
            }, 3000);
        }
        else if (step === 4) {
            step = 5;
            sBadge.innerText = "最终环节：🏆 完整荣耀大总榜";
            sBadge.style.background = "rgba(255,246,0,.2)";
            sBadge.style.borderColor = "#fff600";
            sBadge.style.color = "#fff600";
            mScreen.innerText = "✨ 恭喜所有获奖组合 ✨";
            smHd.innerText = "✨ A + B 全体中奖组合荣耀总表 ✨";
            lBody.innerHTML = "";

            const fullPool = [
                ...groupA.map(i => ({...i, g: 'A'})), 
                ...groupB.map(i => ({...i, g: 'B'}))
            ];

            renderRows(fullPool);
            btn.innerText = "✅ 抽奖活动圆满结束";
            btn.disabled = true;
        }
    }

    function renderRows(pool) {
        const lBody = document.getElementById('l-body');
        pool.forEach((item, index) => {
            let tr = document.createElement('tr');
            tr.className = 'row-in';
            tr.style.animationDelay = `${index * 0.02}s`;

            let details = [];
            if(item.lc) details.push(`<span class="lbl">LC:</span>${item.lc}`);
            if(item.ec) details.push(`<span class="lbl">EC:</span>${item.ec}`);
            let staffText = details.join(' &nbsp;&nbsp;&nbsp; ') || '<span style="color:rgba(255,255,255,0.3)">独立单元</span>';

            let gLabel = '';
            if (item.g) {
                gLabel = item.g === 'A' ? '<span class="tag t-a">A组</span>' : '<span class="tag t-b">B组</span>';
            }

            tr.innerHTML = `
                <td style="color: #fff600; font-weight: bold;">${index + 1}</td>
                <td style="font-weight: bold;">${item.teacher} ${gLabel}</td>
                <td>${staffText}</td>
            `;
            lBody.appendChild(tr);
        });
    }
</script>
</body>
</html>
